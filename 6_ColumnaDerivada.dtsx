                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT TOP 100
    soh.SalesOrderID,
    soh.CustomerID,
    p.FirstName,
    p.LastName,
    soh.TotalDue
FROM Sales.SalesOrderHeader AS soh
INNER JOIN Person.Person AS p
    ON soh.CustomerID = p.BusinessEntityID;</property>
